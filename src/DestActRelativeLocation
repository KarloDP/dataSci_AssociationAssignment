    def load_data(self):
        self.df = pd.read_csv(self.csv_path)

    def clean_data(self):
        """Clean and prepare data for analysis"""
        # Clean budget columns - replace empty strings with NaN and convert to numeric
        for col in self.budget_cols:
            if col in self.df.columns:
                self.df[col] = pd.to_numeric(self.df[col].replace('', np.nan), errors='coerce')

        # Clean region column - strip whitespace and handle missing values
        if self.region_col in self.df.columns:
            self.df[self.region_col] = self.df[self.region_col].fillna('Not Specified').str.strip()

    class ColumnRelativeLocation:
        def __init__(self, series: pd.Series, column_name: str):
            if not pd.api.types.is_numeric_dtype(series):
                raise ValueError(
                    f"'{series.name}' is not numeric. Cannot calculate relative location metrics."
                )

            clean = series.dropna()

            if len(clean) == 0:
                raise ValueError(f"No valid numeric data in column '{series.name}'")

            self.column_name = column_name
            self.count = len(clean)
            self.mean = np.mean(clean)
            self.std = np.std(clean)
            self.min = np.min(clean)
            self.max = np.max(clean)
            self.percentile_25 = np.percentile(clean, 25)
            self.percentile_50 = np.percentile(clean, 50)
            self.percentile_75 = np.percentile(clean, 75)

            self.deciles = {i: np.percentile(clean, i * 10) for i in range(1, 10)}

            self.quartile_1 = self.percentile_25
            self.quartile_2 = self.percentile_50
            self.quartile_3 = self.percentile_75
            self.interquartile_range = self.quartile_3 - self.quartile_1

        def __repr__(self):
            return (
                f"  Count: {self.count}\n"
                f"  Mean: ₱{self.mean:,.2f}\n"
                f"  Std Dev: ₱{self.std:,.2f}\n"
                f"  Min: ₱{self.min:,.2f}\n"
                f"  Max: ₱{self.max:,.2f}\n"
                f"  25th Percentile: ₱{self.percentile_25:,.2f}\n"
                f"  50th Percentile (Median): ₱{self.percentile_50:,.2f}\n"
                f"  75th Percentile: ₱{self.percentile_75:,.2f}\n"
                f"  Deciles: {', '.join([f'D{k}: ₱{v:,.2f}' for k, v in self.deciles.items()])}\n"
                f"  Q1: ₱{self.quartile_1:,.2f}\n"
                f"  Q2 (Median): ₱{self.percentile_50:,.2f}\n"
                f"  Q3: ₱{self.quartile_3:,.2f}\n"
                f"  IQR: ₱{self.interquartile_range:,.2f}"
            )

    class RegionAnalysis:
        def __init__(self, series: pd.Series):
            self.column_name = series.name
            self.total_responses = len(series)
            self.unique_regions = series.nunique()

            # Get value counts and percentages
            self.region_counts = series.value_counts()
            self.region_percentages = (self.region_counts / self.total_responses * 100).round(2)

            # Create a dictionary of region statistics
            self.region_stats = {}
            for region in self.region_counts.index:
                self.region_stats[region] = {
                    'count': int(self.region_counts[region]),
                    'percentage': float(self.region_percentages[region])
                }

        def __repr__(self):
            output = [f"  Total Responses: {self.total_responses}"]
            output.append(f"  Unique Regions: {self.unique_regions}")
            output.append("\n  Region Distribution:")

            # Sort by count descending
            sorted_regions = sorted(self.region_stats.items(), key=lambda x: x[1]['count'], reverse=True)

            for region, stats in sorted_regions:
                output.append(f"    {region}: {stats['count']} ({stats['percentage']}%) বিদেশে")

            return "\n".join(output)

    class BinaryColumnAnalysis:
        def __init__(self, series: pd.Series, column_name: str):
            clean = series.dropna()
            self.column_name = column_name


            self.total_responses = len(clean)
            self.positive_responses = int(clean.sum()) if len(clean) > 0 else 0
            self.positive_percentage = (self.positive_responses / self.total_responses * 100) if self.total_responses > 0 else 0

            # Simplified column name for my sanity
            self.simple_name = self._simplify_name(column_name)

        def _simplify_name(self, column_name: str):
            """Extract the key part of the column name for display"""
            # Remove the common prefix
            if 'tourist_destination_do_you_prefer_' in column_name:
                name = column_name.split('tourist_destination_do_you_prefer_')[-1]
            elif 'activities_are_you_most_interested_in_during_your_trip_' in column_name:
                name = column_name.split('activities_are_you_most_interested_in_during_your_trip_')[-1]
            else:
                name = column_name

            # Simplify name
            name = name.replace('_', ' ').title()
            return name

        def __repr__(self):
            return (
                f"  Simple Name: {self.simple_name}\n"
                f"  Total Responses: {self.total_responses}\n"
                f"  Positive Responses: {self.positive_responses}\n"
                f"  Positive Percentage: {self.positive_percentage:.2f}%"
            )

    def analyze_budgets(self):
