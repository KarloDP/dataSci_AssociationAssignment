    def _print_binary_summary(self, results, title):
        """Print a summary of the top binary results"""
        if results:
            # Sort by percentage descending
            sorted_results = sorted(results, key=lambda x: x['percentage'], reverse=True)

            print("\n" + "="*70)
            print(f"{title}")
            print("="*70)
            print(f"{'Rank':<5} {'Name':<50} {'%':>8}")
            print("-" * 70)

            for i, item in enumerate(sorted_results[:10], 1):
                name = item.get('destination', item.get('activity', ''))
                # Truncate long names
                if len(name) > 50:
                    name = name[:47] + "..."
                print(f"{i:<5} {name:<50} {item['percentage']:>7.2f}%")


