        budget_results = {}

        for col in self.budget_cols:
            if col not in self.df.columns:
                print(f"Budget column '{col}' not found in dataset.")
                continue

            try:
                numeric_series = self.df[col]

                # Filter out NaN values
                valid_data = numeric_series.dropna()

                if len(valid_data) == 0:
                    print(f"No valid data for '{col}'")
                    print("-" * 70)
                    continue

                result_obj = self.ColumnRelativeLocation(valid_data, col)
                budget_results[col] = {
                    'count': result_obj.count,
                    'mean': result_obj.mean,
                    'median': result_obj.percentile_50,
                    'min': result_obj.min,
                    'max': result_obj.max,
                    'std': result_obj.std,
                    'percentiles': {
                        '25': result_obj.percentile_25,
                        '50': result_obj.percentile_50,
                        '75': result_obj.percentile_75
                    }
                }

                print(f"Analysis for: {col}")
                print(result_obj)
                print("-" * 70)

            except Exception as e:
                print(f"Error processing column '{col}': {e}")
                print("-" * 70)

        self.results['budgets'] = budget_results

